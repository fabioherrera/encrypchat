apps/client/macos/Flutter/ephemeral/
apps/client/windows/flutter/ephemeral/
*.g.dart
*.freezed.dart

# Local toolchains (optional)
.tools/

# Bundled Rust FFI (produced by `make build-ffi`)
apps/client/native/*.so
apps/client/native/*.dll
apps/client/native/*.dylib
apps/client/android/app/src/main/jniLibs/**
!apps/client/android/app/src/main/jniLibs/README.md

# Packaged installers (keep docs)
dist/*
