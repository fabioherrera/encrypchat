# Encrypchat monorepo

# Secrets / env
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore
secrets/
credentials.json

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Node / Next.js
node_modules/
apps/web/.next/
apps/web/out/
apps/web/build/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Flutter / Dart
apps/client/.dart_tool/
apps/client/.packages
apps/client/.pub-cache/
apps/client/.pub/
apps/client/build/
apps/client/.flutter-plugins
apps/client/.flutter-plugins-dependencies
